---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/ui';
import { withBase } from '../utils/url';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
  // Path (without locale prefix) the language switcher should point to.
  switchPath?: string;
}

const { lang, switchPath = '' } = Astro.props;
const t = useTranslations(lang);

const nav = [
  { href: getRelativeLocaleUrl(lang, ''), label: t('nav.home') },
  { href: getRelativeLocaleUrl(lang, 'blog'), label: t('nav.blog') },
  { href: getRelativeLocaleUrl(lang, 'tags'), label: t('nav.tags') },
  { href: getRelativeLocaleUrl(lang, 'about'), label: t('nav.about') },
];

// Normalise current path for active-link detection (strip trailing slash).
const current = Astro.url.pathname.replace(/\/$/, '');
---

<header class="site-header">
  <div class="container">
    <a class="brand" href={getRelativeLocaleUrl(lang, '')}>{t('site.title')}</a>
    <nav>
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={current === item.href.replace(/\/$/, '') ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a href={withBase(`${lang}/rss.xml`)} title={t('rss.subscribe')}>
        {t('rss.subscribe')}
      </a>
      <LanguageSwitcher lang={lang} path={switchPath} />
      <ThemeToggle lang={lang} />
    </nav>
  </div>
</header>
