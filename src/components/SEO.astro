---
import type { Lang } from '../i18n/ui';
import {
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_HEIGHT,
  DEFAULT_OG_IMAGE_WIDTH,
  SITE_NAME,
  TWITTER_HANDLE,
  type HreflangLink,
  type PageType,
  absoluteUrl,
  canonicalUrl,
  ogLocale,
} from '../utils/seo';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  type?: PageType;
  pathname: string;
  /** Canonical URL path when it differs from `pathname` (e.g. root → default locale home). */
  canonicalPath?: string;
  site: URL | undefined;
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  hreflang?: HreflangLink[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  lang,
  title,
  description,
  type = 'website',
  pathname,
  canonicalPath,
  site,
  image,
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  hreflang = [],
  jsonLd,
} = Astro.props;

const pageUrl = canonicalUrl(pathname, site);
const canonical = canonicalUrl(canonicalPath ?? pathname, site);
const ogImage = image ? absoluteUrl(image, site) : absoluteUrl(DEFAULT_OG_IMAGE, site);
const robots = noindex ? 'noindex, nofollow' : 'index, follow';
const locale = ogLocale(lang);
const articleModified = modifiedTime ?? publishedTime;
---

<!-- Primary -->
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<meta name="author" content={SITE_NAME} />

<!-- Open Graph -->
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={pageUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(DEFAULT_OG_IMAGE_WIDTH)} />
<meta property="og:image:height" content={String(DEFAULT_OG_IMAGE_HEIGHT)} />
<meta property="og:image:alt" content={description} />

{
  type === 'article' && publishedTime && (
    <>
      <meta property="article:published_time" content={publishedTime.toISOString()} />
      {articleModified && (
        <meta property="article:modified_time" content={articleModified.toISOString()} />
      )}
      {tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={description} />
{TWITTER_HANDLE && <meta name="twitter:site" content={TWITTER_HANDLE} />}

<!-- Language alternates -->
{
  hreflang.map((link) => (
    <link rel="alternate" hreflang={link.hreflang} href={link.href} />
  ))
}

<!-- Structured data -->
{
  jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )
}
