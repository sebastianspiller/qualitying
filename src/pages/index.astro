---
import SEO from '../components/SEO.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { defaultLang, ui } from '../i18n/ui';
import { hreflangForAllLocales, webSiteJsonLd } from '../utils/seo';
import { withBase } from '../utils/url';

const site = Astro.site;
const title = ui.en['site.title'];
const description = ui.en['site.description'];
const redirectTo = withBase(getRelativeLocaleUrl(defaultLang, ''));
const hreflang = site ? hreflangForAllLocales(site, '') : [];
const jsonLd = site ? webSiteJsonLd(site, defaultLang, description) : undefined;
const canonicalPath = getRelativeLocaleUrl(defaultLang, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <SEO
      lang={defaultLang}
      title={title}
      description={description}
      pathname="/"
      canonicalPath={canonicalPath}
      site={site}
      hreflang={hreflang}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <p>
      <a href={redirectTo}>Continue to {title}</a>
    </p>
  </body>
</html>
