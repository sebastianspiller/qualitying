---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { languages, useTranslations, type Lang } from '../../../i18n/ui';
import { getTags } from '../../../utils/posts';
import { isAiTranslatedTag } from '../../../utils/tags';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const tags = await getTags(lang);
---

<BaseLayout
  lang={lang}
  title={t('tags.title')}
  description={t('tags.description')}
  switchPath="tags"
>
  <h1>{t('tags.all')}</h1>
  {
    tags.length === 0 ? (
      <p>{t('tags.empty')}</p>
    ) : (
      <ul class="tag-list tag-list--standalone">
        {tags.map((tag) => (
          <li>
            <a
              class:list={['tag', isAiTranslatedTag(tag) && 'tag--ai-translated']}
              href={getRelativeLocaleUrl(lang, `tags/${tag}`)}
            >
              #{tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
