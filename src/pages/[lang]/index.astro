---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { languages, useTranslations, type Lang } from '../../i18n/ui';
import { getPosts } from '../../utils/posts';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const posts = (await getPosts(lang)).slice(0, 3);
---

<BaseLayout lang={lang} switchPath="">
  <h1>{t('site.title')}</h1>
  <p>{t('home.intro')}</p>

  <h2>{t('home.latest')}</h2>
  {
    posts.length === 0 ? (
      <p>{t('blog.empty')}</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <PostCard post={post} lang={lang} />
        ))}
      </ul>
    )
  }
  <p><a href={getRelativeLocaleUrl(lang, 'blog')}>{t('home.viewAll')} →</a></p>
</BaseLayout>
