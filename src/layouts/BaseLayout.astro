---
import '../styles/global.css';
import Header from '../components/Header.astro';
import SEO from '../components/SEO.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { withBase } from '../utils/url';
import {
  hreflangForAllLocales,
  hreflangForLocales,
  webSiteJsonLd,
  type HreflangLink,
  type PageType,
} from '../utils/seo';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  switchPath?: string;
  /** `website` (default) or `article` for blog posts. */
  seoType?: PageType;
  /** Locales that have a matching page at `switchPath` (for hreflang). Omit to use all locales. */
  hreflangLocales?: Lang[];
  /** Include WebSite JSON-LD (home page). */
  webSiteSchema?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  lang,
  title,
  description,
  switchPath = '',
  seoType = 'website',
  hreflangLocales,
  webSiteSchema = false,
  publishedTime,
  modifiedTime,
  tags,
  image,
  noindex,
  jsonLd,
} = Astro.props;

const t = useTranslations(lang);
const site = Astro.site;

const pageTitle = title ? `${title} — ${t('site.title')}` : t('site.title');
const pageDescription = description ?? t('site.description');
const year = new Date().getFullYear();

let hreflang: HreflangLink[] = [];
if (site) {
  if (hreflangLocales !== undefined) {
    if (hreflangLocales.length > 0) {
      hreflang = hreflangForLocales(site, switchPath, hreflangLocales);
    }
  } else {
    hreflang = hreflangForAllLocales(site, switchPath);
  }
}

const schema =
  jsonLd ??
  (webSiteSchema && site
    ? webSiteJsonLd(site, lang, pageDescription)
    : undefined);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f8fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#070a0f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <SEO
      lang={lang}
      title={pageTitle}
      description={pageDescription}
      type={seoType}
      pathname={Astro.url.pathname}
      site={site}
      image={image}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      noindex={noindex}
      hreflang={hreflang}
      jsonLd={schema}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t('site.title')} (${lang.toUpperCase()})`}
      href={withBase(`${lang}/rss.xml`)}
    />
    <!-- Set theme before paint to avoid a flash of the wrong theme. -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = stored ?? (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header lang={lang} switchPath={switchPath} />
    <main id="main">
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <span>© {year} {t('site.title')}</span>
        <span>{t('footer.builtWith')}</span>
      </div>
    </footer>
  </body>
</html>
